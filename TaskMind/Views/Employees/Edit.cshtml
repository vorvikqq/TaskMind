@model TaskMind.Application.DTOs.Employee.EmployeeEditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Employee</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Employee.Id" />
            <div class="form-group">
                <label asp-for="Employee.Name" class="control-label"></label>
                <input asp-for="Employee.Name" class="form-control" />
                <span asp-validation-for="Employee.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.Skills" class="control-label"></label>
                <input asp-for="Employee.Skills" class="form-control" />
                <span asp-validation-for="Employee.Skills" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.CurrentWorkload" class="control-label"></label>
                <input asp-for="Employee.CurrentWorkload" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Employee.CurrentWorkload" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.TaskCompletionSpeed" class="control-label"></label>
                <input asp-for="Employee.TaskCompletionSpeed" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Employee.TaskCompletionSpeed" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.Team" class="control-label"></label>
                <select asp-for="Employee.TeamId" class="form-control" asp-items="Model.Teams"></select>
                <span asp-validation-for="Employee.TeamId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
