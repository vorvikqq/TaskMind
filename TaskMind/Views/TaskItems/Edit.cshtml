@model TaskMind.Application.DTOs.TaskItem.TaskItemEditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>TaskItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TaskItem.Id" />
            <div class="form-group">
                <label asp-for="TaskItem.Title" class="control-label"></label>
                <input asp-for="TaskItem.Title" class="form-control" />
                <span asp-validation-for="TaskItem.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.Description" class="control-label"></label>
                <input asp-for="TaskItem.Description" class="form-control" />
                <span asp-validation-for="TaskItem.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.Status" class="control-label"></label>
                <select asp-for="TaskItem.Status" class="form-control" asp-items="Model.TaskStates"></select>
                <span asp-validation-for="TaskItem.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.Difficulty" class="control-label"></label>
                <input asp-for="TaskItem.Difficulty" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="TaskItem.Difficulty" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.RequiredSkills" class="control-label"></label>
                <input asp-for="TaskItem.RequiredSkills" class="form-control" />
                <span asp-validation-for="TaskItem.RequiredSkills" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.DeadlineDays" class="control-label"></label>
                <input asp-for="TaskItem.DeadlineDays" class="form-control" />
                <span asp-validation-for="TaskItem.DeadlineDays" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.EstimatedHours" class="control-label"></label>
                <input asp-for="TaskItem.EstimatedHours" class="form-control" />
                <span asp-validation-for="TaskItem.EstimatedHours" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskItem.Team" class="control-label"></label>
                <select asp-for="TaskItem.TeamId" class="form-control" asp-items="Model.Teams"></select>
                <span asp-validation-for="TaskItem.TeamId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
